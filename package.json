{
  "name": "tanstack-hono-monorepo-test-for-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:frontend": "pnpm --filter ./apps/frontend dev",
    "dev:backend": "pnpm --filter ./apps/backend dev",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "eslint:ci": "eslint . --max-warnings 0",
    "eslint:inspect": "pnpm dlx @eslint/config-inspector@latest",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:ci": "biome ci .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prettier:ci": "prettier --check --log-level warn .",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm eslint && pnpm biome && pnpm prettier",
    "lint:fix": "pnpm eslint:fix && pnpm biome:fix && pnpm prettier:fix",
    "prepare": "jiti .husky/install.mts"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@commitlint/cli": "20.1.0",
    "@commitlint/types": "20.0.0",
    "@eslint/config-inspector": "1.3.0",
    "@types/node": "24.10.1",
    "commitlint-config-gitmoji": "2.3.1",
    "consola": "3.4.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jiti": "2.6.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "zod": "4.1.12"
  }
}
